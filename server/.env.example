# Скопируйте в /etc/permtransport.env и заполните
# Секрет для подписи cookie. Сгенерировать: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Пароль для страницы /admin (логин любой)
ADMIN_PASSWORD=
# Срок жизни входа в днях
SESSION_DAYS=90
# Сколько браузеров может использовать один код (Safari + иконка на Домой = 2)
MAX_DEVICES=2
# 1 — только по HTTPS (обязательно на проде), 0 — для локальной проверки по http
COOKIE_SECURE=1
DB_PATH=/var/lib/permtransport/access.db
