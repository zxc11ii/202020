# /etc/systemd/system/permtransport.service
[Unit]
Description=Perm transport demo — access gate
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/permtransport/server
EnvironmentFile=/etc/permtransport.env
ExecStart=/var/www/permtransport/server/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
